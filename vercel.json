{
  "crons": [
    {
      "path": "/api/cron/close-hunts",
      "schedule": "0 15 * * 0"
    },
    {
      "path": "/api/cron/open-hunts",
      "schedule": "0 5 * * 1"
    }
  ],
  "headers": [
    {
      "source": "/_next/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
